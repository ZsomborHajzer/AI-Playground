# Public hostname of the master; Caddy gets its HTTPS certificate for it.
DOMAIN=master.marketplace.example.com
# The URL publishers, mirrors and the app use to reach the master.
MASTER_PUBLIC_URL=https://master.marketplace.example.com

# open: anyone can register at /register and get a publisher token.
# invite: only admins create publishers (Admin → Publishers).
REGISTRATION=open

MAX_UPLOAD_MB=20
REPLICATION_INTERVAL_SECONDS=15
LOG_LEVEL=info
