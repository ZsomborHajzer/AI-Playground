# Public hostname of this distribution server; Caddy gets its HTTPS certificate for it.
DOMAIN=eu.marketplace.example.com

# From Admin → Mirrors → "Add a distribution server" on the master (shown once).
MIRROR_ID=eu-1a2b3c
MIRROR_SECRET=paste-the-secret-here
MASTER_URL=https://master.marketplace.example.com

# How often to pull from the master in case a push was missed, and to report downloads.
CATCHUP_INTERVAL_SECONDS=600
STATS_FLUSH_SECONDS=300
LOG_LEVEL=info
