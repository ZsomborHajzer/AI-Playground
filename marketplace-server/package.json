{
  "name": "aipg-marketplace-server",
  "version": "0.1.0",
  "private": true,
  "description": "Master and distribution servers for the AI Playground plugin marketplace, plus the aipg-plugin CLI",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "aipg-plugin": "./cli/aipg-plugin.ts"
  },
  "scripts": {
    "master": "node master/server.ts",
    "mirror": "node mirror/server.ts",
    "admin:create": "node master/adminCli.ts",
    "aipg-plugin": "node cli/aipg-plugin.ts",
    "schema": "node cli/aipg-plugin.ts schema > shared/aipg-plugin.schema.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fastify/formbody": "9.0.1",
    "@fastify/multipart": "10.1.8",
    "fastify": "5.12.8",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
